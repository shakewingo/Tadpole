# Copy this file to deploy/telegram-bot.env (gitignored — never commit real values) and fill
# in the values below. See the README for how to obtain them.

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user ID (e.g. from @userinfobot). Only this user's messages
# are ever executed; every other sender is silently ignored.
TELEGRAM_ALLOWED_USER_ID=

# Optional. Defaults to ./outputs/telegram_sessions (relative to the repository root).
TELEGRAM_STATE_DIR=

# The model. Leave AGENT_BASE_URL empty to run a local GGUF with llama.cpp: AGENT_MODEL_PATH,
# by default models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf at the repository root. Set
# AGENT_BASE_URL and AGENT_MODEL to use any OpenAI-compatible API instead (AGENT_API_KEY is not
# needed for a local server; AGENT_N_CTX is the model's window, default 32768).
AGENT_MODEL_PATH=
# Optional. One of Tadpole's trained adapters on the local GGUF, in llama.cpp's format, e.g.
# models/ei-3-lora-f16.gguf (see the README). Set AGENT_PLANNING=0 with it: the adapters were
# trained and measured without the plan tool.
AGENT_LORA_PATH=
AGENT_PLANNING=
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_API_KEY=
AGENT_N_CTX=

# Optional. Absolute path to the Python that has this project's dependencies, e.g. a conda
# env's bin/python. Defaults to <repo>/.venv/bin/python if it exists, otherwise python3.
PYTHON=

# Copy to deploy/telegram-bot.env (gitignored; never commit it) and fill in.

# ---------------------------------------------------------------------------------------------
# Telegram (required)
# ---------------------------------------------------------------------------------------------

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Your numeric user ID, from @userinfobot. The bot ignores everyone else.
TELEGRAM_ALLOWED_USER_ID=

# ---------------------------------------------------------------------------------------------
# Model: uncomment ONE block. With none, the bot runs Qwen3-4B Q4_K_M with llama.cpp (block C).
# The README's "Choose a model" table has the details and the download commands.
# ---------------------------------------------------------------------------------------------

# A. Any OpenAI-compatible API (OpenAI, DeepSeek, OpenRouter, LM Studio, vLLM)
# AGENT_BASE_URL=https://api.deepseek.com
# AGENT_MODEL=deepseek-flash
# AGENT_API_KEY=
# AGENT_N_CTX=32768

# B. A local model with Ollama: any model with tool calling, e.g. Qwen3-4B
#    (start it with OLLAMA_CONTEXT_LENGTH=32768 ollama serve)
# AGENT_BASE_URL=http://localhost:11434/v1
# AGENT_MODEL=hf.co/unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M
# AGENT_N_CTX=32768

# C. A local GGUF with llama.cpp, in-process (macOS): Qwen2 or Qwen3 only
# AGENT_MODEL_PATH=models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf

# D. Post-trained Qwen3-4B: a Tadpole adapter on the Q8_0 base, with llama.cpp (macOS).
#    Planning is then off, as in the adapters' training and evaluation.
# AGENT_MODEL_PATH=models/Qwen3-4B-Instruct-2507-Q8_0.gguf
# AGENT_LORA_PATH=models/ei-3-lora-f16.gguf

# ---------------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------------

# Where sessions are saved. Default: outputs/telegram_sessions
# TELEGRAM_STATE_DIR=

# The Python with this project's dependencies, e.g. a conda env's bin/python.
# Default: .venv/bin/python if it exists, otherwise python3
# PYTHON=

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tadpole.telegram-bot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <!-- /REPLACE/WITH/REPO/PATH is the repository's absolute path (the README's sed fills it in). -->
        <string>/REPLACE/WITH/REPO/PATH/agent_from_scratch/scripts/run_telegram_bot.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/REPLACE/WITH/REPO/PATH/outputs/telegram_bot.log</string>
    <key>StandardErrorPath</key>
    <string>/REPLACE/WITH/REPO/PATH/outputs/telegram_bot.log</string>
</dict>
</plist>
